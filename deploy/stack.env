# Non-secret deploy configuration, committed so it is reviewable in a diff.
# Secrets are repository secrets and are listed in deploy/README.md.

VERIFIER_HOST=demo.eudiw.grnet.gr

# The prefix the three route groups hang off: /verifier/ui, /verifier/utilities
# and /verifier/wallet. No trailing slash; compose appends one per path.
VERIFIER_PATH=/verifier

# Goes into request_uri and response_uri inside the signed request object, so
# the wallet resolves these. Not rewritable after issuance. Must match
# VERIFIER_HOST and VERIFIER_PATH exactly, and carry no trailing slash.
VERIFIER_PUBLIC_URL=https://demo.eudiw.grnet.gr/verifier

# pre-registered: the wallet is expected to know the verifier out of band and
# fetches the key from /wallet/public-keys.json. The request object carries only
# a `kid`. x509_san_dns would send the certificate chain instead and require a
# leaf from WEBUILD/pki/ with VERIFIER_HOST as a SAN.
VERIFIER_CLIENT_ID_PREFIX=pre-registered
VERIFIER_CLIENT_ID=Verifier

# Alias of the key inside the keystore keystore-init generates, and the
# algorithm it is signed with. The algorithm must match the curve in that
# container's openssl call: prime256v1 is P-256, which pairs with ES256.
# A mismatch fails at request time, not at startup, with
# "The ES256 algorithm is not allowed or supported by the JWS signer".
VERIFIER_KEYSTORE_ALIAS=access_certificate
VERIFIER_SIGNING_ALGORITHM=ES256

# Presented to the wallet as the reason for the request. The certificate that
# goes with it is a secret, because it is a signed JWT naming us.
VERIFIER_INTENDED_USE_ID=1
VERIFIER_INTENDED_USE_DESCRIPTION=Person identification

LETSENCRYPT_EMAIL=devops-rnd@grnet.gr

# The keystore lives in a named volume written by keystore-init on first
# deploy, so there is nothing to place on the box by hand and no path here.
